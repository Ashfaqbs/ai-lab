{
  "manifest_version": 3,
  "name": "InfraMask",
  "version": "0.1.0",
  "description": "Masks secrets and infra identifiers (passwords, API keys, bootstrap servers, IPs) before they reach an AI chat UI, and restores them in the response view only.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "InfraMask"
  },
  "permissions": ["storage"],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/detectors.js",
        "src/token-store.js",
        "src/masking-engine.js",
        "src/site-adapters.js",
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
